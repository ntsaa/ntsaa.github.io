{
  "Version": "1.0.1",
  "Scripts": {
    "GetText": [
      "(function () {",
      "  const images = document.querySelectorAll('img[loading=\"lazy\"]');",
      "  let texts = Array.from(images).map(img => (img.alt || '').trim()).filter(t => t !== '');",
      "  if (texts.length >= 2) return { status: 'SUCCESS', texts };",
      "",
      "  const overlayBlocks = document.querySelectorAll('div[jsname=\"V68bde\"] span');",
      "  if (overlayBlocks.length > 0) {",
      "    const joinedText = Array.from(overlayBlocks).map(span => (span.innerText || '').trim()).filter(t => t !== '').join(' ');",
      "    if (joinedText) return { status: 'SUCCESS', texts: [joinedText] };",
      "  }",
      "",
      "  if (texts.length > 0) return { status: 'SUCCESS', texts };",
      "",
      "  const hasClearButton = !!document.querySelector('button[jsname=\"X5DuWc\"], button[aria-label=\"Clear image\"]');",
      "  if (hasClearButton) return { status: 'PENDING' };",
      "",
      "  return { status: 'NO_TEXT' };",
      "})();"
    ],
    "GetSecondImageBase64": [
      "(function() {",
      "  try {",
      "    const images = document.querySelectorAll('img[loading=\"lazy\"]');",
      "    const img = images.length > 1 ? images[1] : images[0];",
      "    if (!img) return null;",
      "    const canvas = document.createElement('canvas');",
      "    canvas.width = img.naturalWidth;",
      "    canvas.height = img.naturalHeight;",
      "    canvas.getContext('2d').drawImage(img, 0, 0);",
      "    return canvas.toDataURL('image/png');",
      "  } catch { return null; }",
      "})();"
    ],
    "ClearPreviousImage": [
      "(() => {",
      "  const btns = document.querySelectorAll('button[jsname=\"X5DuWc\"]');",
      "  if (btns.length) { btns[btns.length - 1].click(); return 'ok'; }",
      "  const alt = document.querySelector('button[aria-label=\"Clear image\"]');",
      "  if (alt) { alt.click(); return 'ok'; }",
      "  return 'no';",
      "})()"
    ],
    "WaitForUploadCompleted": [
      "(() => {",
      "  const btn = document.querySelector('button[jsname=\"X5DuWc\"], button[aria-label=\"Clear image\"]');",
      "  if (btn) return 'ok';",
      "  const uploader = document.querySelector('input[type=\"file\"]');",
      "  return uploader ? 'pending' : 'error';",
      "})()"
    ],
    "PasteImageFromClipboard": [
      "(() => {",
      "  const btn = document.querySelector('button[jsname=\"xcJrbc\"]');",
      "  if (btn) { btn.click(); return 'ok'; }",
      "  const alt = [...document.querySelectorAll('button')].find(b => b.getAttribute('aria-label') === 'Paste an image from clipboard');",
      "  if (alt) { alt.click(); return 'ok'; }",
      "  return 'no';",
      "})()"
    ],
    "FindFileInput": [
      "(function() {",
      "  const inputs = [...document.querySelectorAll('input[type=file]')];",
      "  return inputs.find(i => i.accept && i.accept.toLowerCase().includes('image') && !i.disabled );",
      "})()"
    ]
  }
}